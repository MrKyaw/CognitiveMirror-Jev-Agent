# Deployment mode: local | private_cloud | enterprise
# enterprise refuses the dev API keys and requires auth.
CM_DEPLOYMENT_MODE=local

# SQLite file for memory, shared context, audit log and feedback.
CM_DB_PATH=data/cognitive_mirror.db

# Optional PostgreSQL backend (takes precedence over CM_DB_PATH when set).
# CM_DATABASE_URL=postgresql://cm:cm@db:5432/cm

# Comma-separated <api-key>:<role> pairs. Roles: agent | admin | compliance.
CM_API_KEYS=dev-agent-key:agent,dev-admin-key:admin,dev-compliance-key:compliance
CM_REQUIRE_AUTH=true

# Role granted to the trusted local process on the stdio transport.
CM_STDIO_ROLE=agent

# Memory retention (days) and multi-agent shared context TTL (minutes).
CM_RETENTION_DAYS=30
CM_SHARED_CONTEXT_TTL_MINUTES=240

# Guardrail policy profile: default | strict | enterprise
CM_POLICY_PROFILE=default

# Optional enterprise Jev dimension override (JSON, merged over the built-in config).
# CM_JEV_CONFIG=/path/to/jev_dimensions.json

# Optional live System One / Jev cross-check on build_jev_profile.
# Unset = deterministic offline engine only. Set = one fan-out call per profile.
# TYPESAFE_API_KEY=
# CM_JEV_MODEL=jev-latest

# Optional LLM enricher (off by default): none | openai | anthropic
CM_LLM_PROVIDER=none
CM_LLM_API_KEY=
CM_LLM_MODEL=
CM_LLM_BASE_URL=
CM_LLM_TIMEOUT_S=4.0

# Enable MCP DNS-rebinding protection by listing allowed Host headers (e.g. localhost:*).
CM_ALLOWED_HOSTS=
CM_LOG_LEVEL=INFO
